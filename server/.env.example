# ---- 上游模型（OpenAI 兼容）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=90

# ---- 鉴权 ----
TOKEN_SECRET=please-change-this-to-a-long-random-string
TOKEN_TTL_DAYS=30
ALLOW_ANONYMOUS=true
INTERNAL_KEY=please-change-internal-key

# ---- 限流 ----
RATE_LIMIT_PER_HOUR=60
RATE_LIMIT_GENERATE_PER_HOUR=20

# ---- 审计 ----
AUDIT_DB_PATH=/data/audit.sqlite3
# 仅排障时打开：会把模型输出原文写进审计库（含答案）
LOG_ANSWER_TEXT=false

# ---- 合规 ----
MAX_SELECTED_CHARS=600
